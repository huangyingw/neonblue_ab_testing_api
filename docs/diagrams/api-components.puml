@startuml API Components

skinparam backgroundColor white
skinparam defaultFontSize 12
skinparam rectangleBorderColor #333333

title A/B Testing API - Component Structure

rectangle "app/" as App #LightBlue {

    rectangle "Entry Point" as Entry #LightGreen {
        [main.py] as Main
    }

    rectangle "API Routers" as Routers #LightYellow {
        [experiments.py] as ExpR
        [events.py] as EventR
        [feature_flags.py] as FlagR
    }

    rectangle "Core Services" as Services #LightPink {
        [auth.py] as Auth
        [cache.py] as Cache
    }

    rectangle "Data Access" as Data #LightCyan {
        [models.py] as Models
        [schemas.py] as Schemas
        [database.py] as DB
    }

    rectangle "Configuration" as Config #LightGray {
        [config.py] as Conf
    }
}

database "SQLite" as SQLite #WhiteSmoke

Main --> ExpR
Main --> EventR
Main --> FlagR

ExpR --> Auth
EventR --> Auth
FlagR --> Auth

ExpR --> Cache
FlagR --> Cache

ExpR --> Models
EventR --> Models
FlagR --> Models

ExpR --> Schemas
EventR --> Schemas
FlagR --> Schemas

Models --> DB
DB --> SQLite
DB --> Conf
Auth --> Conf

note right of Routers
  **Endpoints:**
  /experiments/*
  /events/*
  /flags/*
end note

note right of Cache
  In-memory TTL cache
  for assignments and
  flag evaluations
end note

@enduml
