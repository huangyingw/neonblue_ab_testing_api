@startuml Database ER Diagram

' ============================================================================
' Database Entity-Relationship Diagram
' ============================================================================
' This diagram shows the database schema for the A/B Testing API.
'
' Tables:
' - experiments: A/B test definitions with name, description, status
' - variants: Different versions in an experiment (e.g., Control, Treatment)
' - assignments: Maps users to variants (idempotent, one per user per experiment)
' - events: User actions/conversions with flexible JSON properties
' - feature_flags: Simple on/off toggles with rollout percentage
' - feature_flag_overrides: Per-user overrides for feature flags
'
' Key constraints:
' - assignments: UNIQUE(experiment_id, user_id) ensures idempotency
' - feature_flag_overrides: UNIQUE(feature_flag_id, user_id) one override per user
' ============================================================================

!define TABLE(x) entity x << (T,#FFAAAA) >>
!define PK(x) <u>x</u>
!define FK(x) <i>x</i>

skinparam backgroundColor white
skinparam entity {
    BackgroundColor LightYellow
    BorderColor DarkOrange
}

title A/B Testing API - Database Schema (PostgreSQL)

TABLE(experiments) {
    PK(id) : INTEGER
    --
    name : VARCHAR
    description : VARCHAR
    status : VARCHAR
    created_at : DATETIME
}

TABLE(variants) {
    PK(id) : INTEGER
    --
    FK(experiment_id) : INTEGER
    name : VARCHAR
    traffic_percentage : FLOAT
    created_at : DATETIME
}

TABLE(assignments) {
    PK(id) : INTEGER
    --
    FK(experiment_id) : INTEGER
    FK(variant_id) : INTEGER
    user_id : VARCHAR
    assigned_at : DATETIME
    ==
    UNIQUE(experiment_id, user_id)
}

TABLE(events) {
    PK(id) : INTEGER
    --
    user_id : VARCHAR
    event_type : VARCHAR
    timestamp : DATETIME
    properties : JSON
    ==
    INDEX(user_id, timestamp)
    INDEX(event_type)
}

TABLE(feature_flags) {
    PK(id) : INTEGER
    --
    key : VARCHAR <<unique>>
    name : VARCHAR
    description : VARCHAR
    enabled : INTEGER
    rollout_percentage : FLOAT
    created_at : DATETIME
    updated_at : DATETIME
}

TABLE(feature_flag_overrides) {
    PK(id) : INTEGER
    --
    FK(feature_flag_id) : INTEGER
    user_id : VARCHAR
    enabled : INTEGER
    created_at : DATETIME
    ==
    UNIQUE(feature_flag_id, user_id)
}

experiments ||--o{ variants : "has"
experiments ||--o{ assignments : "has"
variants ||--o{ assignments : "assigned to"
feature_flags ||--o{ feature_flag_overrides : "has"

note right of assignments
  Ensures idempotent
  user assignment
end note

note right of events
  Events linked to users
  via user_id field
  (not FK for flexibility)
end note

@enduml
