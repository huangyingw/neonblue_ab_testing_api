@startuml Deployment Architecture

skinparam backgroundColor white
skinparam node {
    BackgroundColor LightSteelBlue
    BorderColor DarkBlue
}
skinparam artifact {
    BackgroundColor LightGoldenRodYellow
    BorderColor DarkGoldenRod
}
skinparam database {
    BackgroundColor LightCyan
    BorderColor DarkCyan
}

title A/B Testing API - Deployment Architecture

node "Docker Compose Environment" as DockerEnv {

    node "Production Profile" as Prod #LightGreen {
        node "db container" as DBContainer {
            database "PostgreSQL 16\n(Alpine)" as ProdDB
        }

        node "api container" as ProdContainer {
            artifact "FastAPI App" as ProdApp
            artifact "uvicorn" as ProdUvicorn
        }

        ProdContainer --> DBContainer : "DATABASE_URL\npostgresql://..."
    }

    node "Development Profile" as Dev #LightYellow {
        node "db container" as DevDBContainer {
            database "PostgreSQL 16" as DevDB
        }

        node "dev container" as DevContainer {
            artifact "FastAPI App" as DevApp
            artifact "uvicorn\n(--reload)" as DevUvicorn
        }

        DevContainer --> DevDBContainer
    }

    node "Test Profile" as Test #LightPink {
        node "db-test container" as TestDBContainer {
            database "PostgreSQL 16\n(isolated)" as TestDB
        }

        node "test container" as TestContainer {
            artifact "pytest" as Pytest
            artifact "Mock Repositories" as MockRepo
        }

        note right of MockRepo
          Unit tests use
          mock repositories
          (no DB access)
        end note
    }

    node "Integration Profile" as Integration #LightCoral {
        node "db-test container" as IntDBContainer {
            database "PostgreSQL 16" as IntDB
        }

        node "api-test container" as IntAPIContainer {
            artifact "FastAPI App" as IntApp
        }

        node "integration container" as IntTestContainer {
            artifact "pytest\n(integration)" as IntPytest
        }

        IntAPIContainer --> IntDBContainer
        IntTestContainer --> IntAPIContainer : "HTTP requests"
    }
}

cloud "Internet" as Internet {
    actor "API Clients" as Clients
}

Clients --> ProdContainer : "HTTPS:8000"

note bottom of DockerEnv
  **Commands:**
  Production: docker compose up
  Development: docker compose --profile dev up
  Unit Tests: docker compose --profile test run --rm test
  Integration: docker compose --profile integration up --abort-on-container-exit
end note

note right of Prod
  **Production Features:**
  - Connection pooling (pool_size=5)
  - Health checks
  - Auto-restart
  - Persistent volume
end note

@enduml
