@startuml Feature Flag Evaluation

skinparam backgroundColor white
skinparam sequence {
    ArrowColor DarkGreen
    ActorBorderColor DarkGreen
    LifeLineBorderColor DarkGreen
    ParticipantBackgroundColor LightGreen
    ParticipantBorderColor DarkGreen
}

title Feature Flag Evaluation Flow

actor Client
participant "FastAPI" as API
participant "Auth" as Auth
participant "Cache" as Cache
participant "Feature Flag\nRouter" as Router
database "SQLite" as DB

Client -> API : GET /flags/{key}/evaluate/{user_id}\n[Authorization: Bearer token]
API -> Auth : Validate token
Auth --> API : Token valid

API -> Router : Evaluate flag
Router -> Cache : Check cache\nkey: "flag_eval:{key}:{user_id}"

alt Cache Hit
    Cache --> Router : Cached result
    Router --> API : FeatureFlagEvaluation
    API --> Client : 200 OK

else Cache Miss
    Cache --> Router : Not found

    Router -> DB : Query feature flag
    DB --> Router : Flag data

    alt User Override Exists
        Router -> DB : Query user override
        DB --> Router : Override found
        Router --> Router : reason = "user_override"

    else Flag Globally Enabled
        Router --> Router : reason = "global"

    else Rollout Percentage > 0
        Router --> Router : Calculate hash\nMD5(key:user_id) % 100

        alt Hash < rollout_percentage
            Router --> Router : enabled = true\nreason = "rollout"
        else
            Router --> Router : enabled = false\nreason = "disabled"
        end

    else
        Router --> Router : enabled = false\nreason = "disabled"
    end

    Router -> Cache : Store result (TTL: 1min)
    Cache --> Router : Cached

    Router --> API : FeatureFlagEvaluation
    API --> Client : 200 OK\n{"key": "...", "enabled": true/false, "reason": "..."}
end

note right of Router
  Evaluation Priority:
  1. User Override
  2. Global Enable
  3. Rollout Percentage
  4. Disabled (default)
end note

@enduml
