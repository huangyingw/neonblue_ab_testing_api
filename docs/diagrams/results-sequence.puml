@startuml Results Calculation

skinparam backgroundColor white
skinparam sequence {
    ArrowColor DarkOrange
    ActorBorderColor DarkOrange
    LifeLineBorderColor DarkOrange
    ParticipantBackgroundColor LightYellow
    ParticipantBorderColor DarkOrange
}

title Experiment Results Calculation Flow (Repository Pattern)

actor Client
participant "Router\n(experiments.py)" as Router
participant "Auth" as Auth
participant "ExperimentRepository\n(interface)" as ExpRepo
participant "EventRepository\n(interface)" as EventRepo
participant "SQLAlchemy\nImplementation" as Impl
participant "Statistics\n(scipy)" as Stats
database "PostgreSQL" as DB

Client -> Router : GET /experiments/{id}/results\n?event_type=purchase\n&start_date=...\n&end_date=...
Router -> Auth : Validate token
Auth --> Router : Token valid

Router -> ExpRepo : get_by_id(experiment_id)
ExpRepo -> Impl : get_by_id()
Impl -> DB : SELECT experiment + variants
DB --> Impl : Experiment data
Impl --> ExpRepo : ExperimentEntity
ExpRepo --> Router : ExperimentEntity

loop For each variant
    Router -> ExpRepo : get_assignments_by_variant(variant_id)
    ExpRepo -> Impl : get_assignments_by_variant()
    Impl -> DB : SELECT assignments
    DB --> Impl : Assignments list
    Impl --> ExpRepo : list[AssignmentEntity]
    ExpRepo --> Router : list[AssignmentEntity]

    loop For each assignment
        Router -> EventRepo : get_events_for_user_after(\n  user_id,\n  after=assigned_at,\n  event_type,\n  start_date,\n  end_date)
        EventRepo -> Impl : get_events_for_user_after()
        Impl -> DB : SELECT events\nWHERE user_id = ?\nAND timestamp > assigned_at\nAND event_type = ? (optional)\nAND timestamp BETWEEN ? AND ?
        DB --> Impl : User events
        Impl --> EventRepo : list[EventEntity]
        EventRepo --> Router : list[EventEntity]
    end

    Router --> Router : Calculate:\n- user_count\n- event_count\n- conversion_rate\n- events_by_type
end

Router -> Stats : Calculate chi-square
Stats --> Stats : Build contingency table\n[[users_with_events, users_without], ...]
Stats --> Stats : scipy.stats.chi2_contingency()
Stats --> Router : chi2, p_value, is_significant

Router --> Client : 200 OK\n{\n  "total_users": 100,\n  "variants": [...],\n  "statistical_significance": {\n    "p_value": 0.03,\n    "is_significant": true\n  }\n}

note right of ExpRepo
  **Repository Pattern:**
  - ExperimentRepository: experiments, variants, assignments
  - EventRepository: events
  - No direct DB access in Router
end note

note right of Router
  Only events AFTER
  assignment timestamp
  are counted
end note

note right of Stats
  Chi-square test
  determines if
  variant differences
  are statistically
  significant (p < 0.05)
end note

@enduml
