@startuml System Architecture

skinparam backgroundColor white
skinparam defaultFontSize 12

title A/B Testing API - System Architecture (Simplified)

' ===== Clients =====
actor "Web App" as Web
actor "Mobile App" as Mobile
actor "CLI/Scripts" as CLI

' ===== API Layer =====
rectangle "Docker Container" as Docker #LightBlue {

    rectangle "FastAPI Application" as API #LightGreen {

        rectangle "Authentication" as AuthLayer #LightYellow {
            [Bearer Token\nValidation] as Auth
        }

        rectangle "API Endpoints" as Endpoints #LightCyan {
            [/experiments] as Exp
            [/events] as Event
            [/flags] as Flags
        }

        rectangle "Caching" as CacheLayer #LightPink {
            [In-Memory Cache\n(TTL: 1-5 min)] as Cache
        }
    }

    database "SQLite" as DB #WhiteSmoke {
        [experiments]
        [variants]
        [assignments]
        [events]
        [feature_flags]
    }
}

' ===== Connections =====
Web --> Auth : HTTPS
Mobile --> Auth : HTTPS
CLI --> Auth : HTTPS

Auth --> Exp
Auth --> Event
Auth --> Flags

Exp --> Cache : read/write
Flags --> Cache : read/write

Exp --> DB
Event --> DB
Flags --> DB

' ===== Notes =====
note bottom of Docker
  **Running Command:**
  docker-compose up

  **Port:** 8000
  **Docs:** /docs
end note

note right of Cache
  **Cached Data:**
  - User assignments
  - Flag evaluations

  **Purpose:**
  Reduce DB queries
  for frequent calls
end note

@enduml
